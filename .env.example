# Backend Environment Variables (for local development)
# Copy this to backend/.env and fill in real values

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:trustpass_dev@localhost:5433/trustpass
FRONTEND_URL=http://localhost:3000

# Cryptographic Keys - Generate using: npm run keygen
# For Docker Compose: Leave these empty and keys will auto-generate on first run
# For local dev: Run npm run keygen and paste the output here
JWT_SECRET=your_jwt_secret_here_min_48_chars_hex
ENCRYPTION_KEY=32_character_base64_string
ISSUER_PRIVATE_KEY=ed25519_private_key_hex
ISSUER_PUBLIC_KEY=ed25519_public_key_hex
ISSUER_NAME=TrustPass Authority

# Frontend Environment Variables
# Copy to frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:4000/api
